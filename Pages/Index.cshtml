@page
@model IndexModel
@using System.Net

@{
    var serverName = Dns.GetHostName();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>My .NET App | Azure DevOps Deployment Group</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            min-height: 100vh;
            background: #f4f7fb;
            color: #1f2937;
        }

        .navbar {
            background: #111827;
            color: white;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
        }

        .badge {
            background: #2563eb;
            padding: 8px 15px;
            border-radius: 20px;
            font-size: 13px;
        }

        .hero {
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 55px 20px 30px;
        }

        .card {
            background: white;
            max-width: 950px;
            width: 100%;
            padding: 50px 45px;
            border-radius: 20px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
        }

        .icon {
            font-size: 55px;
            margin-bottom: 18px;
        }

        h1 {
            font-size: 42px;
            margin-bottom: 15px;
            color: #111827;
        }

        .subtitle {
            font-size: 18px;
            color: #6b7280;
            line-height: 1.7;
            margin-bottom: 25px;
        }

        .status {
            display: inline-block;
            background: #dcfce7;
            color: #166534;
            padding: 10px 20px;
            border-radius: 25px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .version {
            color: #6b7280;
            font-size: 14px;
            margin-bottom: 40px;
        }

        .server-highlight {
            background: #eff6ff;
            border: 2px solid #2563eb;
            border-radius: 15px;
            padding: 20px;
            margin: 20px 0 35px;
        }

        .server-highlight .label {
            display: block;
            color: #6b7280;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .server-highlight .server-name {
            display: block;
            color: #1d4ed8;
            font-size: 26px;
            font-weight: bold;
        }

        .section-title {
            font-size: 25px;
            color: #111827;
            margin: 35px 0 20px;
        }

        .info {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-top: 20px;
        }

        .info-box {
            background: #f9fafb;
            padding: 20px 15px;
            border-radius: 14px;
            border: 1px solid #e5e7eb;
        }

        .info-box strong {
            display: block;
            color: #2563eb;
            margin-bottom: 7px;
            font-size: 16px;
        }

        .info-box span {
            font-size: 14px;
            color: #6b7280;
            line-height: 1.5;
        }

        .architecture {
            margin-top: 25px;
            background: #111827;
            color: white;
            padding: 25px;
            border-radius: 15px;
            text-align: left;
            overflow-x: auto;
        }

        .architecture pre {
            font-family: Consolas, monospace;
            font-size: 14px;
            line-height: 1.8;
            white-space: pre-wrap;
        }

        .achievements {
            text-align: left;
            margin-top: 25px;
        }

        .achievement {
            background: #f9fafb;
            border-left: 5px solid #2563eb;
            padding: 15px 18px;
            margin-bottom: 12px;
            border-radius: 8px;
        }

        .achievement strong {
            color: #111827;
        }

        .technology {
            display: inline-block;
            background: #eff6ff;
            color: #1d4ed8;
            padding: 7px 12px;
            border-radius: 20px;
            margin: 5px;
            font-size: 13px;
            font-weight: bold;
        }

        footer {
            text-align: center;
            padding: 25px;
            color: #6b7280;
            font-size: 14px;
        }

        @@media (max-width: 700px) {

            h1 {
                font-size: 32px;
            }

            .card {
                padding: 35px 20px;
            }

            .info {
                grid-template-columns: 1fr;
            }

            .navbar {
                padding: 16px 5%;
            }

            .architecture pre {
                font-size: 12px;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar">
        <div class="logo">My .NET App</div>
        <div class="badge">Azure DevOps CI/CD</div>
    </nav>

    <!-- Main Hero -->
    <main class="hero">

        <div class="card">

            <div class="icon">🚀</div>

            <h1>Hello from Azure DevOps!</h1>

            <p class="subtitle">
                This ASP.NET Core application has been deployed to Azure Virtual Machines
                using an automated <strong>Azure DevOps Deployment Group</strong>.
            </p>

            <div class="status">
                ✓ Deployment Group Deployment Successful
            </div>

            <div class="version">
                Deployment Test: Release-6 | VM Deployment
            </div>

            <!-- Current Server -->
            <div class="server-highlight">
                <span class="label">Application served by</span>
                <span class="server-name">@serverName</span>
            </div>

            <!-- Current Environment -->
            <h2 class="section-title">
                Current Environment
            </h2>

            <div class="info">

                <div class="info-box">
                    <strong>Server</strong>
                    <span>@serverName</span>
                </div>

                <div class="info-box">
                    <strong>ASP.NET Core</strong>
                    <span>Web Application</span>
                </div>

                <div class="info-box">
                    <strong>.NET 10</strong>
                    <span>Application Runtime</span>
                </div>

                <div class="info-box">
                    <strong>Azure VM</strong>
                    <span>Deployment Target</span>
                </div>

                <div class="info-box">
                    <strong>Port 5000</strong>
                    <span>ASP.NET Core Application</span>
                </div>

                <div class="info-box">
                    <strong>Deployment Group</strong>
                    <span>DotNetApp-VMs</span>
                </div>

                <div class="info-box">
                    <strong>Environment</strong>
                    <span>Production</span>
                </div>

            </div>

            <!-- Technologies -->
            <h2 class="section-title">
                Technologies Used
            </h2>

            <div>

                <span class="technology">.NET 10</span>
                <span class="technology">ASP.NET Core</span>
                <span class="technology">Azure DevOps</span>
                <span class="technology">GitHub</span>
                <span class="technology">Deployment Groups</span>
                <span class="technology">Azure VM</span>
                <span class="technology">Linux</span>
                <span class="technology">systemd</span>
                <span class="technology">Bash</span>
                <span class="technology">CI/CD</span>

            </div>

            <!-- CI/CD Architecture -->
            <h2 class="section-title">
                CI/CD Architecture
            </h2>

            <div class="architecture">

<pre>
Developer
    │
    │ git push
    ▼
GitHub Repository
    │
    │ main branch
    ▼
Azure DevOps Build Pipeline
    │
    │ Restore
    │ Build
    │ Publish
    ▼
Build Artifact
    │
    ▼
Azure DevOps Release Pipeline
    │
    ▼
Deployment Group
DotNetApp-VMs
    │
    ├──────────────────────────┐
    ▼                          ▼
deployment-vm-01          deployment-vm-02
    │                          │
    │ systemd                 │ systemd
    ▼                          ▼
ASP.NET Core              ASP.NET Core
    │                          │
    ▼                          ▼
Port 5000                 Port 5000
    │                          │
    └────────────┬─────────────┘
                 ▼
          Application Response
</pre>

            </div>

            <!-- Learning / Achievements -->
            <h2 class="section-title">
                Azure & DevOps Work Completed
            </h2>

            <div class="achievements">

                <div class="achievement">
                    <strong>✓ Azure Virtual Machines</strong><br />
                    Created two Azure Linux VMs as deployment targets for the
                    ASP.NET Core application.
                </div>

                <div class="achievement">
                    <strong>✓ Network Security</strong><br />
                    Configured the required Azure networking and NSG rules
                    for the deployment VMs.
                </div>

                <div class="achievement">
                    <strong>✓ GitHub Integration</strong><br />
                    Connected the application source code with GitHub and
                    configured the Azure DevOps build process.
                </div>

                <div class="achievement">
                    <strong>✓ Azure DevOps Build Pipeline</strong><br />
                    Created a build pipeline to restore, build and publish
                    the ASP.NET Core application as an artifact.
                </div>

                <div class="achievement">
                    <strong>✓ Deployment Group</strong><br />
                    Created the <strong>DotNetApp-VMs</strong> deployment group
                    and registered two Linux VM deployment targets.
                </div>

                <div class="achievement">
                    <strong>✓ Deployment Group Agents</strong><br />
                    Configured Azure DevOps deployment agents on
                    <strong>deployment-vm-01</strong> and
                    <strong>deployment-vm-02</strong>.
                </div>

                <div class="achievement">
                    <strong>✓ .NET 10 Runtime</strong><br />
                    Installed the required .NET 10 and ASP.NET Core 10
                    runtimes on both deployment VMs.
                </div>

                <div class="achievement">
                    <strong>✓ Linux systemd Service</strong><br />
                    Configured <strong>mydotnetapp.service</strong> to manage
                    the ASP.NET Core application as a Linux system service.
                </div>

                <div class="achievement">
                    <strong>✓ Classic Release Pipeline</strong><br />
                    Created a Release pipeline to download the build artifact
                    and deploy the application to both deployment VMs.
                </div>

                <div class="achievement">
                    <strong>✓ Automated VM Deployment</strong><br />
                    Azure DevOps deploys the published application files,
                    restarts the systemd service and runs the application
                    on port 5000.
                </div>

                <div class="achievement">
                    <strong>✓ Server Identification</strong><br />
                    The application dynamically displays the hostname of the
                    Azure VM serving the current request.
                </div>

            </div>

            <!-- Deployment Flow -->
            <h2 class="section-title">
                Deployment Flow
            </h2>

            <div class="architecture">

<pre>
1. Developer changes application code
        ↓
2. git add / git commit / git push
        ↓
3. Code reaches GitHub main branch
        ↓
4. Azure DevOps Build Pipeline is triggered
        ↓
5. Application is restored and built
        ↓
6. Application is published
        ↓
7. Build artifact is created
        ↓
8. Release Pipeline receives the artifact
        ↓
9. Deployment Group targets both Azure VMs
        ↓
10. Artifact is copied to /var/www/MyDotNetApp
        ↓
11. systemd service is restarted
        ↓
12. ASP.NET Core application starts
        ↓
13. Application becomes available on port 5000
        ↓
14. Browser displays the VM hostname
</pre>

            </div>

        </div>

    </main>

    <footer>
        © 2026 My .NET App · Azure DevOps · Deployment Groups · Azure VMs
    </footer>

</body>
</html>