@page
@model IndexModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>My .NET App | Azure App Service</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            min-height: 100vh;
            background: #f4f7fb;
            color: #1f2937;
        }

        .navbar {
            background: #111827;
            color: white;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
        }

        .badge {
            background: #2563eb;
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 13px;
        }

        .hero {
            min-height: 70vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 40px 20px;
        }

        .card {
            background: white;
            max-width: 750px;
            width: 100%;
            padding: 55px 45px;
            border-radius: 18px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
        }

        .icon {
            font-size: 55px;
            margin-bottom: 20px;
        }

        h1 {
            font-size: 42px;
            margin-bottom: 15px;
            color: #111827;
        }

        .subtitle {
            font-size: 19px;
            color: #6b7280;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .status {
            display: inline-block;
            background: #dcfce7;
            color: #166534;
            padding: 10px 18px;
            border-radius: 25px;
            font-weight: bold;
            margin-bottom: 35px;
        }

        .info {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-top: 20px;
        }

        .info-box {
            background: #f9fafb;
            padding: 18px 10px;
            border-radius: 12px;
        }

        .info-box strong {
            display: block;
            color: #2563eb;
            margin-bottom: 5px;
        }

        .info-box span {
            font-size: 14px;
            color: #6b7280;
        }

        footer {
            text-align: center;
            padding: 20px;
            color: #6b7280;
            font-size: 14px;
        }

        @@media (max-width: 600px) {
            h1 {
                font-size: 32px;
            }

            .card {
                padding: 40px 20px;
            }

            .info {
                grid-template-columns: 1fr;
            }

            .navbar {
                padding: 16px 5%;
            }
        }
    </style>
</head>

<body>

    <nav class="navbar">
        <div class="logo">My .NET App</div>
        <div class="badge">Azure App Service</div>
    </nav>

    <main class="hero">
        <div class="card">

            <div class="icon">☁️</div>

            <h1>Hello from Azure!</h1>

            <p class="subtitle">
                This ASP.NET Core application is running on
                <strong>Azure App Service</strong> and deployed automatically
                using <strong>Azure DevOps CI/CD</strong> with Docker and
                Azure Container Registry.
            </p>

            <div class="status">
                ✓ Application is running
            </div>

            <div class="info">

                <div class="info-box">
                    <strong>ASP.NET Core</strong>
                    <span>Web Application</span>
                </div>

                <div class="info-box">
                    <strong>.NET 10</strong>
                    <span>Runtime</span>
                </div>

                <div class="info-box">
                    <strong>Azure DevOps</strong>
                    <span>CI/CD Pipeline</span>
                </div>

            </div>

        </div>
    </main>

    <footer>
        © 2026 My .NET App · Docker · ACR · Azure App Service
    </footer>

</body>
</html>